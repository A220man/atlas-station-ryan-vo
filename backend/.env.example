# Atlas Station Backend Configuration
# Copy to .env and fill in values

# App
APP_NAME=atlas-station
APP_VERSION=1.0.0
DEBUG=false
HOST=127.0.0.1
PORT=8000

# Database
DATABASE_URL=sqlite:///./data/atlas.db

# Storage
UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./data/outputs
MAX_UPLOAD_SIZE_MB=2048

# Auth (Keycloak OIDC)
OIDC_ENABLED=true
OIDC_ISSUER_URL=http://localhost:8080/realms/atlas
OIDC_CLIENT_ID=atlas-frontend
OIDC_CLIENT_SECRET=your-client-secret-here
OIDC_REDIRECT_URI=http://localhost:3000/callback
OIDC_SCOPES=openid profile email roles

# LLM (optional - for AI explanations)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=
LLM_BASE_URL=

# Processing
WORKER_CONCURRENCY=1
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe